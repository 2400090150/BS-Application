PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
# Main Admin identity is trusted server configuration and cannot be changed in the dashboard.
MAIN_ADMIN_EMAIL=rupeshravu@gmail.com
# Required only for one-time owner setup on a database with no configured Main Admin.
# Generate a random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MAIN_ADMIN_SETUP_TOKEN=

# Optional Google Identity Services (create OAuth Web Client ID in Google Cloud Console)
GOOGLE_CLIENT_ID=
# Optional Google Picker configuration for Website Images in the admin dashboard.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
